<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">LLMCostControl Admin</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div id="nav-scrollable" class="nav-scrollable">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        @* Read-only reporting views — visible to any signed-in admin user (§12.3, M18). *@
        <AuthorizeView Roles="@ReadOnlyRoles" Context="reportsContext">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="reports">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Reports
                </NavLink>
            </div>
        </AuthorizeView>

        @* Administrative commands — visible to the Admin role only (§12.3, M17/M18). *@
        <AuthorizeView Roles="@AdminAuthorization.AdminRole" Context="adminContext">
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="administration" data-testid="admin-nav-link">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Administration
                </NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="pricing" data-testid="pricing-nav-link">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Pricing
                </NavLink>
            </div>
        </AuthorizeView>
    </nav>
</div>

@code {
    private static readonly string ReadOnlyRoles =
        $"{AdminAuthorization.AdminRole},{AdminAuthorization.ReadOnlyRole}";
}
