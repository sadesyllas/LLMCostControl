@page "/groups"
@attribute [Authorize]
@inject IDbContextFactory<CostTrackerDbContext> DbFactory
@using LLMCostControl.Domain.Budgets
@using LLMCostControl.Domain.Common
@using LLMCostControl.Infrastructure.Data
@using LLMCostControl.Infrastructure.Repositories
@using Microsoft.EntityFrameworkCore

<div class="admin-container">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Manage Groups</h1>
            <p class="text-muted mb-0">Create groups, set Monthly/Weekly budgets, and assign members.</p>
        </div>
    </div>

    <AlertMessage Message="@_globalErrorMessage" Type="AlertMessage.AlertType.Danger" OnClose="() => _globalErrorMessage = null" />
    <AlertMessage Message="@_globalSuccessMessage" Type="AlertMessage.AlertType.Success" OnClose="() => _globalSuccessMessage = null" />

    <AuthorizeView Roles="CostTracker.Admin">
        <Authorized>
            <div class="card shadow-sm border-0 mb-4 bg-light">
                <div class="card-body">
                    <h2 class="h5 card-title mb-3">Create New Group</h2>
                    <form @onsubmit="CreateGroupAsync" @onsubmit:preventDefault class="row g-3 align-items-center">
                        <div class="col-md-8">
                            <label for="newGroupName" class="visually-hidden">Group Name</label>
                            <input type="text" id="newGroupName" class="form-control py-2" placeholder="e.g. engineering-team" @bind="_newGroupName" />
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-primary py-2 w-100" id="btn-create-group">Create Group</button>
                        </div>
                    </form>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>

    @if (_groups == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading groups...</span>
            </div>
        </div>
    }
    else if (!_groups.Any())
    {
        <div class="text-center py-5 card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-0">No groups found. Create a group to get started.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var group in _groups)
            {
                <div class="col-12" id="group-@group.Id">
                    <div class="card shadow-sm border-0 group-detail-card">
                        <div class="card-body p-4">
                            <!-- Group Title & Actions -->
                            <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
                                <div>
                                    @if (group.IsEditing)
                                    {
                                        <div class="d-flex gap-2 align-items-center">
                                            <input type="text" class="form-control form-control-sm edit-group-name-input" @bind="group.EditName" />
                                            <button class="btn btn-sm btn-success btn-save-rename" @onclick="() => RenameGroupAsync(group)">Save</button>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => group.IsEditing = false">Cancel</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <h3 class="h4 mb-0 group-name-title">@group.Name</h3>
                                        <small class="text-muted">Created: @group.CreatedAt.ToString("g")</small>
                                    }
                                </div>
                                <AuthorizeView Roles="CostTracker.Admin">
                                    <Authorized>
                                        <div class="d-flex gap-2">
                                            @if (!group.IsEditing)
                                            {
                                                <button class="btn btn-sm btn-outline-primary btn-rename-group" @onclick="() => { group.IsEditing = true; group.EditName = group.Name; }">Rename</button>
                                            }
                                            <button class="btn btn-sm btn-outline-danger btn-delete-group" @onclick="() => DeleteGroupAsync(group.Id)">Delete</button>
                                        </div>
                                    </Authorized>
                                </AuthorizeView>
                            </div>

                            <AlertMessage Message="@group.ErrorMessage" Type="AlertMessage.AlertType.Danger" Dismissible="false" ShowHeader="false" CssClass="py-2 mb-3 small error-message-block" />

                            <div class="row g-4">
                                <!-- Budget Section -->
                                <div class="col-md-6">
                                    <div class="row g-3">
                                        <!-- Monthly Budget Column -->
                                        <div class="col-sm-6">
                                            <div class="p-3 bg-light rounded-3 h-100">
                                                <h4 class="h6 mb-3 text-uppercase text-secondary tracking-wider font-semibold">Monthly Budget</h4>
                                                <div class="mb-3 budget-amount-display">
                                                    @if (group.MonthlyBudget != null)
                                                    {
                                                        <div class="d-flex align-items-baseline gap-2">
                                                            <span class="h3 mb-0 text-primary font-bold">@group.MonthlyBudget.Amount.Amount.ToString("F2")</span>
                                                            <span class="text-muted">@group.MonthlyBudget.Amount.Currency</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted italic no-budget-message">No budget set for current period.</span>
                                                    }
                                                </div>

                                                <AuthorizeView Roles="CostTracker.Admin">
                                                    <Authorized>
                                                        <div class="border-top pt-3">
                                                            <div class="row g-2">
                                                                <div class="col-7">
                                                                    <input type="number" class="form-control form-control-sm input-budget-amount" placeholder="Amount" @bind="group.NewMonthlyBudgetAmount" min="0" step="0.01" />
                                                                </div>
                                                                <div class="col-5">
                                                                    <select class="form-select form-select-sm select-budget-currency" @bind="group.NewMonthlyBudgetCurrency">
                                                                        <option value="USD">USD</option>
                                                                        <option value="EUR">EUR</option>
                                                                        <option value="GBP">GBP</option>
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="d-flex gap-2 mt-2">
                                                                <button class="btn btn-sm btn-primary w-100 btn-set-budget" @onclick="() => UpdateBudgetAsync(group, BudgetPeriodType.Monthly)">Set Budget</button>
                                                                @if (group.MonthlyBudget != null)
                                                                {
                                                                    <button class="btn btn-sm btn-outline-danger btn-clear-budget" @onclick="() => ClearBudgetAsync(group, BudgetPeriodType.Monthly)">Clear</button>
                                                                }
                                                            </div>
                                                        </div>
                                                    </Authorized>
                                                </AuthorizeView>
                                            </div>
                                        </div>

                                        <!-- Weekly Budget Column -->
                                        <div class="col-sm-6">
                                            <div class="p-3 bg-light rounded-3 h-100">
                                                <h4 class="h6 mb-3 text-uppercase text-secondary tracking-wider font-semibold">Weekly Budget</h4>
                                                <div class="mb-3 budget-amount-display">
                                                    @if (group.WeeklyBudget != null)
                                                    {
                                                        <div class="d-flex align-items-baseline gap-2">
                                                            <span class="h3 mb-0 text-primary font-bold">@group.WeeklyBudget.Amount.Amount.ToString("F2")</span>
                                                            <span class="text-muted">@group.WeeklyBudget.Amount.Currency</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted italic no-budget-message">No budget set for current period.</span>
                                                    }
                                                </div>

                                                <AuthorizeView Roles="CostTracker.Admin">
                                                    <Authorized>
                                                        <div class="border-top pt-3">
                                                            <div class="row g-2">
                                                                <div class="col-7">
                                                                    <input type="number" class="form-control form-control-sm input-weekly-budget-amount" placeholder="Amount" @bind="group.NewWeeklyBudgetAmount" min="0" step="0.01" />
                                                                </div>
                                                                <div class="col-5">
                                                                    <select class="form-select form-select-sm select-weekly-budget-currency" @bind="group.NewWeeklyBudgetCurrency">
                                                                        <option value="USD">USD</option>
                                                                        <option value="EUR">EUR</option>
                                                                        <option value="GBP">GBP</option>
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            <div class="d-flex gap-2 mt-2">
                                                                <button class="btn btn-sm btn-primary w-100 btn-set-weekly-budget" @onclick="() => UpdateBudgetAsync(group, BudgetPeriodType.Weekly)">Set Budget</button>
                                                                @if (group.WeeklyBudget != null)
                                                                {
                                                                    <button class="btn btn-sm btn-outline-danger btn-clear-weekly-budget" @onclick="() => ClearBudgetAsync(group, BudgetPeriodType.Weekly)">Clear</button>
                                                                }
                                                            </div>
                                                        </div>
                                                    </Authorized>
                                                </AuthorizeView>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Members Section -->
                                <div class="col-md-6">
                                    <div class="p-3 bg-light rounded-3 h-100 d-flex flex-column">
                                        <h4 class="h6 mb-3 text-uppercase text-secondary tracking-wider font-semibold">Group Members</h4>
                                        
                                        <div class="flex-grow-1 mb-3">
                                            @if (group.Members == null || !group.Members.Any())
                                            {
                                                <p class="text-muted small mb-0 italic no-members-message">No members assigned to this group.</p>
                                            }
                                            else
                                            {
                                                <ul class="list-group list-group-flush bg-transparent members-list">
                                                    @foreach (var member in group.Members)
                                                    {
                                                        <li class="list-group-item d-flex justify-content-between align-items-center bg-transparent px-0 py-2 member-item">
                                                            <span class="small font-mono text-dark member-email">@member.CallerId.Value</span>
                                                            <AuthorizeView Roles="CostTracker.Admin">
                                                                <Authorized>
                                                                    <button type="button" class="btn-close btn-close-small btn-remove-member" @onclick="() => RemoveMemberAsync(group.Id, member.CallerId.Value, group)" aria-label="Remove member"></button>
                                                                </Authorized>
                                                            </AuthorizeView>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </div>

                                        <AuthorizeView Roles="CostTracker.Admin">
                                            <Authorized>
                                                <div class="border-top pt-3">
                                                    <form @onsubmit="() => AddMemberAsync(group)" @onsubmit:preventDefault class="d-flex gap-2">
                                                        <input type="text" class="form-control form-control-sm input-member-email" placeholder="Member email" @bind="group.NewMemberEmail" />
                                                        <button type="submit" class="btn btn-sm btn-primary btn-add-member">Add</button>
                                                    </form>
                                                </div>
                                            </Authorized>
                                        </AuthorizeView>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private List<GroupViewModel> _groups = new();
    private string _newGroupName = string.Empty;
    private string? _globalErrorMessage;
    private string? _globalSuccessMessage;
    private bool _isAdmin;

    /// <summary>
    /// UI-specific representation of a group to manage component state.
    /// </summary>
    public sealed class GroupViewModel
    {
        public Guid Id { get; init; }
        public string Name { get; set; } = string.Empty;
        public DateTimeOffset CreatedAt { get; init; }
        public GroupBudget? MonthlyBudget { get; set; }
        public GroupBudget? WeeklyBudget { get; set; }
        public List<GroupMembership> Members { get; set; } = new();

        // UI states
        public bool IsEditing { get; set; }
        public string EditName { get; set; } = string.Empty;
        public string NewMemberEmail { get; set; } = string.Empty;
        public decimal? NewMonthlyBudgetAmount { get; set; }
        public string NewMonthlyBudgetCurrency { get; set; } = "USD";
        public decimal? NewWeeklyBudgetAmount { get; set; }
        public string NewWeeklyBudgetCurrency { get; set; } = "USD";
        public string? ErrorMessage { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateTask;
        _isAdmin = authState.User.IsInRole("CostTracker.Admin");

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var groupRepo = new GroupRepository(context);
            var budgetRepo = new GroupBudgetRepository(context);
            var membershipRepo = new GroupMembershipRepository(context);

            var domainGroups = await groupRepo.GetAllAsync();
            var viewModels = new List<GroupViewModel>();

            foreach (var g in domainGroups)
            {
                var monthlyBudget = await budgetRepo.GetAsync(g.Id, BudgetPeriodType.Monthly);
                var weeklyBudget = await budgetRepo.GetAsync(g.Id, BudgetPeriodType.Weekly);
                var memberships = await membershipRepo.GetMembersAsync(g.Id);

                viewModels.Add(new GroupViewModel
                {
                    Id = g.Id,
                    Name = g.Name,
                    CreatedAt = g.CreatedAt,
                    MonthlyBudget = monthlyBudget,
                    WeeklyBudget = weeklyBudget,
                    Members = memberships,
                    EditName = g.Name,
                    NewMonthlyBudgetAmount = monthlyBudget?.Amount.Amount,
                    NewMonthlyBudgetCurrency = monthlyBudget?.Amount.Currency ?? "USD",
                    NewWeeklyBudgetAmount = weeklyBudget?.Amount.Amount,
                    NewWeeklyBudgetCurrency = weeklyBudget?.Amount.Currency ?? "USD",
                });
            }

            _groups = viewModels;
        }
        catch (Exception ex)
        {
            _globalErrorMessage = $"Failed to load groups: {ex.Message}";
        }
    }

    private async Task CreateGroupAsync()
    {
        if (!_isAdmin) return;
        if (string.IsNullOrWhiteSpace(_newGroupName))
        {
            _globalErrorMessage = "Group name cannot be empty.";
            return;
        }

        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var groupRepo = new GroupRepository(context);

            var group = Group.Create(_newGroupName.Trim());
            await groupRepo.AddAsync(group);

            _newGroupName = string.Empty;
            _globalErrorMessage = null;
            _globalSuccessMessage = $"Group '{group.Name}' created successfully.";

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _globalErrorMessage = $"Failed to create group: {ex.Message}";
        }
    }

    private async Task RenameGroupAsync(GroupViewModel model)
    {
        if (!_isAdmin) return;
        if (string.IsNullOrWhiteSpace(model.EditName))
        {
            model.ErrorMessage = "Group name cannot be empty.";
            return;
        }

        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var groupRepo = new GroupRepository(context);

            var group = await groupRepo.GetByIdAsync(model.Id);
            if (group != null)
            {
                group.Name = model.EditName.Trim();
                await groupRepo.UpdateAsync(group);
            }

            model.IsEditing = false;
            model.ErrorMessage = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            model.ErrorMessage = $"Failed to rename group: {ex.Message}";
        }
    }

    private async Task DeleteGroupAsync(Guid groupId)
    {
        if (!_isAdmin) return;
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var groupRepo = new GroupRepository(context);

            await groupRepo.DeleteAsync(groupId);

            _globalSuccessMessage = "Group deleted successfully.";
            _globalErrorMessage = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _globalErrorMessage = $"Failed to delete group: {ex.Message}";
        }
    }

    private async Task UpdateBudgetAsync(GroupViewModel model, BudgetPeriodType periodType)
    {
        if (!_isAdmin) return;
        decimal? amount = periodType == BudgetPeriodType.Monthly ? model.NewMonthlyBudgetAmount : model.NewWeeklyBudgetAmount;
        string currency = periodType == BudgetPeriodType.Monthly ? model.NewMonthlyBudgetCurrency : model.NewWeeklyBudgetCurrency;

        if (amount is null or < 0m)
        {
            model.ErrorMessage = $"{periodType} budget amount must be zero or positive.";
            return;
        }

        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var budgetRepo = new GroupBudgetRepository(context);

            var money = new Money(amount.Value, currency);
            var budget = GroupBudget.Create(model.Id, money, periodType);

            await budgetRepo.UpsertAsync(budget);
            model.ErrorMessage = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            model.ErrorMessage = $"Failed to update {periodType} budget: {ex.Message}";
        }
    }

    private async Task ClearBudgetAsync(GroupViewModel model, BudgetPeriodType periodType)
    {
        if (!_isAdmin) return;
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var budgetRepo = new GroupBudgetRepository(context);

            await budgetRepo.DeleteAsync(model.Id, periodType);
            if (periodType == BudgetPeriodType.Monthly)
            {
                model.NewMonthlyBudgetAmount = null;
            }
            else
            {
                model.NewWeeklyBudgetAmount = null;
            }
            model.ErrorMessage = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            model.ErrorMessage = $"Failed to clear {periodType} budget: {ex.Message}";
        }
    }

    private async Task AddMemberAsync(GroupViewModel model)
    {
        if (!_isAdmin) return;
        if (string.IsNullOrWhiteSpace(model.NewMemberEmail))
        {
            model.ErrorMessage = "Member email cannot be empty.";
            return;
        }

        try
        {
            var callerId = CallerId.From(model.NewMemberEmail.Trim());

            await using var context = await DbFactory.CreateDbContextAsync();
            var membershipRepo = new GroupMembershipRepository(context);

            var existing = await membershipRepo.IsMemberAsync(model.Id, callerId);

            if (existing)
            {
                model.ErrorMessage = "User is already a member of this group.";
                return;
            }

            var membership = GroupMembership.Create(model.Id, callerId);
            await membershipRepo.AddAsync(membership);

            model.NewMemberEmail = string.Empty;
            model.ErrorMessage = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            model.ErrorMessage = $"Failed to add member: {ex.Message}";
        }
    }

    private async Task RemoveMemberAsync(Guid groupId, string email, GroupViewModel model)
    {
        if (!_isAdmin) return;
        try
        {
            var callerId = CallerId.From(email);
            await using var context = await DbFactory.CreateDbContextAsync();
            var membershipRepo = new GroupMembershipRepository(context);

            await membershipRepo.RemoveAsync(groupId, callerId);
            model.ErrorMessage = null;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            model.ErrorMessage = $"Failed to remove member: {ex.Message}";
        }
    }
}
