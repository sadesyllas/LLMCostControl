@page "/groups/{GroupId}"
@attribute [Authorize(Roles = AppRoles.Admin)]
@inject IAdminCommandService Admin
@inject NavigationManager Navigation

<PageTitle>Group Detail</PageTitle>

@if (_group is null)
{
    <p>Loading...</p>
}
else
{
    <h1>@_group.Name</h1>
    <p class="text-muted">Created @_group.CreatedAt.ToString("yyyy-MM-dd")</p>

    <h2 class="mt-4">Budget (current period)</h2>
    @if (_budget is null)
    {
        <p class="text-muted">No budget set for the current period.</p>
    }
    else
    {
        <p>Amount: <strong>@_budget.Amount.Amount @(_budget.Amount.Currency)</strong></p>
    }
    <div class="row g-2 mb-2">
        <div class="col-auto">
            <input class="form-control" type="number" step="0.01" @bind="_budgetAmount" placeholder="Amount" />
        </div>
        <div class="col-auto">
            <input class="form-control" style="width:80px" @bind="_budgetCurrency" placeholder="USD" />
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="SetBudget">Set Budget</button>
        </div>
        @if (_budget is not null)
        {
            <div class="col-auto">
                <button class="btn btn-outline-danger" @onclick="ClearBudget">Clear</button>
            </div>
        }
    </div>
    @if (_budgetError is not null)
    {
        <div class="text-danger">@_budgetError</div>
    }

    <h2 class="mt-4">Members</h2>
    <div class="mb-3">
        <div class="input-group" style="max-width:400px">
            <input class="form-control" @bind="_newMember" placeholder="caller@example.com" />
            <button class="btn btn-primary" @onclick="AddMember">Add</button>
        </div>
        @if (_memberError is not null)
        {
            <div class="text-danger mt-1">@_memberError</div>
        }
    </div>
    @if (_members is null || _members.Count == 0)
    {
        <p class="text-muted">No members yet.</p>
    }
    else
    {
        <table class="table table-sm">
            <thead>
                <tr><th>Caller ID</th><th>Added</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var m in _members)
                {
                    <tr>
                        <td>@m.CallerId.Value</td>
                        <td>@m.AddedAt.ToString("yyyy-MM-dd")</td>
                        <td><button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveMember(m.CallerId.Value)">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter] public Guid GroupId { get; set; }

    private Group? _group;
    private GroupBudget? _budget;
    private List<GroupMembership>? _members;
    private decimal _budgetAmount;
    private string _budgetCurrency = "USD";
    private string? _budgetError;
    private string _newMember = string.Empty;
    private string? _memberError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
    }

    private async Task LoadAll()
    {
        var groups = await Admin.ListGroupsAsync();
        _group = groups.FirstOrDefault(g => g.Id == GroupId);
        _budget = await Admin.GetGroupBudgetAsync(GroupId);
        _members = await Admin.ListMembersAsync(GroupId);
        if (_budget is not null)
        {
            _budgetAmount = _budget.Amount.Amount;
            _budgetCurrency = _budget.Amount.Currency;
        }
    }

    private async Task SetBudget()
    {
        if (_budgetAmount < 0)
        {
            _budgetError = "Budget amount cannot be negative.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_budgetCurrency))
        {
            _budgetError = "Currency is required.";
            return;
        }
        await Admin.SetGroupBudgetAsync(GroupId, _budgetAmount, _budgetCurrency);
        _budgetError = null;
        await LoadAll();
    }

    private async Task ClearBudget()
    {
        await Admin.ClearGroupBudgetAsync(GroupId);
        _budgetError = null;
        await LoadAll();
    }

    private async Task AddMember()
    {
        if (string.IsNullOrWhiteSpace(_newMember))
        {
            _memberError = "Caller ID is required.";
            return;
        }
        try
        {
            await Admin.AddMemberAsync(GroupId, _newMember);
            _newMember = string.Empty;
            _memberError = null;
            await LoadAll();
        }
        catch (Exception ex)
        {
            _memberError = ex.Message;
        }
    }

    private async Task RemoveMember(string callerId)
    {
        await Admin.RemoveMemberAsync(GroupId, callerId);
        await LoadAll();
    }
}
