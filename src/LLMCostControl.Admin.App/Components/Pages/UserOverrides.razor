@page "/overrides"
@attribute [Authorize(Roles = AppRoles.Admin)]
@inject IAdminCommandService Admin

<PageTitle>User Budget Overrides</PageTitle>

<h1>User Budget Overrides</h1>

<div class="mb-3">
    <div class="row g-2" style="max-width:600px">
        <div class="col">
            <input class="form-control" @bind="_newCallerId" placeholder="caller@example.com" />
        </div>
        <div class="col-auto">
            <input class="form-control" type="number" step="0.01" style="width:120px" @bind="_newAmount" placeholder="Amount" />
        </div>
        <div class="col-auto">
            <input class="form-control" style="width:80px" @bind="_newCurrency" placeholder="USD" />
        </div>
        <div class="col-auto">
            <button class="btn btn-primary" @onclick="SetOverride">Set Override</button>
        </div>
    </div>
    @if (_error is not null)
    {
        <div class="text-danger mt-1">@_error</div>
    }
</div>

@if (_overrides is null)
{
    <p>Loading...</p>
}
else if (_overrides.Count == 0)
{
    <p class="text-muted">No overrides set for the current period.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr><th>Caller ID</th><th>Amount</th><th>Currency</th><th>Set</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var o in _overrides)
            {
                <tr>
                    <td>@o.CallerId.Value</td>
                    <td>@o.Amount.Amount</td>
                    <td>@o.Amount.Currency</td>
                    <td>@o.SetAt.ToString("yyyy-MM-dd")</td>
                    <td><button class="btn btn-sm btn-outline-danger" @onclick="() => ClearOverride(o.CallerId.Value)">Clear</button></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<UserBudgetOverride>? _overrides;
    private string _newCallerId = string.Empty;
    private decimal _newAmount;
    private string _newCurrency = "USD";
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadOverrides();
    }

    private async Task LoadOverrides()
    {
        _overrides = await Admin.ListUserOverridesAsync();
    }

    private async Task SetOverride()
    {
        if (string.IsNullOrWhiteSpace(_newCallerId))
        {
            _error = "Caller ID is required.";
            return;
        }
        if (_newAmount < 0)
        {
            _error = "Amount cannot be negative.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_newCurrency))
        {
            _error = "Currency is required.";
            return;
        }

        await Admin.SetUserOverrideAsync(_newCallerId, _newAmount, _newCurrency);
        _newCallerId = string.Empty;
        _newAmount = 0;
        _error = null;
        await LoadOverrides();
    }

    private async Task ClearOverride(string callerId)
    {
        await Admin.ClearUserOverrideAsync(callerId);
        await LoadOverrides();
    }
}
