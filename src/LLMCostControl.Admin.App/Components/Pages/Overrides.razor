@page "/overrides"
@attribute [Authorize]
@inject IDbContextFactory<CostTrackerDbContext> DbFactory
@using LLMCostControl.Domain.Budgets
@using LLMCostControl.Domain.Common
@using LLMCostControl.Infrastructure.Data
@using LLMCostControl.Infrastructure.Repositories
@using Microsoft.EntityFrameworkCore

<div class="admin-container">
    <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Per-User Budget Overrides</h1>
            <p class="text-muted mb-0">Set explicit user-level budgets that override group-level budgets for the current period: <strong>@_currentPeriod</strong></p>
        </div>
        <div>
            <span class="badge bg-secondary p-2">Period: @_currentPeriod</span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_globalErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible mb-4 shadow-sm" role="alert">
            <strong>Error:</strong> @_globalErrorMessage
            <button type="button" class="btn-close" @onclick="() => _globalErrorMessage = null" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(_globalSuccessMessage))
    {
        <div class="alert alert-success alert-dismissible mb-4 shadow-sm" role="alert">
            <strong>Success:</strong> @_globalSuccessMessage
            <button type="button" class="btn-close" @onclick="() => _globalSuccessMessage = null" aria-label="Close"></button>
        </div>
    }

    <AuthorizeView Roles="CostTracker.Admin">
        <Authorized>
            <div class="card shadow-sm border-0 mb-4 bg-light">
                <div class="card-body">
                    <h2 class="h5 card-title mb-3">Set / Update User Budget Override</h2>
                    <form @onsubmit="SaveOverrideAsync" @onsubmit:preventDefault class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label for="callerId" class="form-label small font-semibold">Caller Email ID</label>
                            <input type="text" id="callerId" class="form-control form-control-sm py-2" placeholder="user@example.com" @bind="_newCallerId" />
                        </div>
                        <div class="col-md-3">
                            <label for="amount" class="form-label small font-semibold">Monthly Budget Amount</label>
                            <input type="number" id="amount" class="form-control form-control-sm py-2" placeholder="0.00" @bind="_newAmount" min="0" step="0.01" />
                        </div>
                        <div class="col-md-2">
                            <label for="currency" class="form-label small font-semibold">Currency</label>
                            <select id="currency" class="form-select form-select-sm py-2" @bind="_newCurrency">
                                <option value="USD">USD</option>
                                <option value="EUR">EUR</option>
                                <option value="GBP">GBP</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary btn-sm py-2 w-100 font-medium" id="btn-save-override">Set Override</button>
                        </div>
                    </form>
                </div>
            </div>
        </Authorized>
    </AuthorizeView>

    @if (_overrides == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading overrides...</span>
            </div>
        </div>
    }
    else if (!_overrides.Any())
    {
        <div class="text-center py-5 card border-0 shadow-sm">
            <div class="card-body">
                <p class="text-muted mb-0">No per-user overrides found for this period.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="overrides-table">
                    <thead class="table-light">
                        <tr>
                            <th class="py-3 px-4">User (Caller ID)</th>
                            <th class="py-3 px-4">Monthly Budget</th>
                            <th class="py-3 px-4">Period</th>
                            <th class="py-3 px-4">Set Timestamp</th>
                            <AuthorizeView Roles="CostTracker.Admin">
                                <Authorized>
                                    <th class="py-3 px-4 text-end">Actions</th>
                                </Authorized>
                            </AuthorizeView>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ov in _overrides)
                        {
                            <tr id="override-@ov.CallerId.Value.Replace("@", "-at-").Replace(".", "-dot-")">
                                <td class="px-4 font-mono font-medium small override-caller-email">@ov.CallerId.Value</td>
                                <td class="px-4 font-bold text-primary override-amount-display">@ov.Amount.Amount.ToString("F2") <span class="text-muted font-normal small">@ov.Amount.Currency</span></td>
                                <td class="px-4 small text-muted">@ov.Period</td>
                                <td class="px-4 small text-muted">@ov.SetAt.ToString("g")</td>
                                <AuthorizeView Roles="CostTracker.Admin">
                                    <Authorized>
                                        <td class="px-4 text-end">
                                            <button class="btn btn-sm btn-outline-primary me-2 btn-edit-override" @onclick="() => PopulateForEdit(ov)">Edit</button>
                                            <button class="btn btn-sm btn-outline-danger btn-clear-override" @onclick="() => DeleteOverrideAsync(ov.CallerId.Value)">Clear</button>
                                        </td>
                                    </Authorized>
                                </AuthorizeView>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private List<UserBudgetOverride>? _overrides;
    private string _newCallerId = string.Empty;
    private decimal? _newAmount;
    private string _newCurrency = "USD";
    private string? _globalErrorMessage;
    private string? _globalSuccessMessage;
    private BudgetPeriod _currentPeriod;
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        _currentPeriod = BudgetPeriod.Current();
        var authState = await AuthStateTask;
        _isAdmin = authState.User.IsInRole("CostTracker.Admin");

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        try
        {
            await using var context = await DbFactory.CreateDbContextAsync();
            var repo = new UserBudgetOverrideRepository(context);
            _overrides = await repo.GetForPeriodAsync(_currentPeriod);
        }
        catch (Exception ex)
        {
            _globalErrorMessage = $"Failed to load user overrides: {ex.Message}";
        }
    }

    private async Task SaveOverrideAsync()
    {
        if (!_isAdmin) return;
        if (string.IsNullOrWhiteSpace(_newCallerId))
        {
            _globalErrorMessage = "Caller Email ID cannot be empty.";
            return;
        }

        if (_newAmount is null or < 0m)
        {
            _globalErrorMessage = "Budget amount must be zero or positive.";
            return;
        }

        try
        {
            var callerId = CallerId.From(_newCallerId);
            var money = new Money(_newAmount.Value, _newCurrency);
            
            await using var context = await DbFactory.CreateDbContextAsync();
            var repo = new UserBudgetOverrideRepository(context);

            var overrideEntity = UserBudgetOverride.Create(callerId, money, _currentPeriod);
            await repo.UpsertAsync(overrideEntity);

            _newCallerId = string.Empty;
            _newAmount = null;
            _globalErrorMessage = null;
            _globalSuccessMessage = $"Budget override for user '{callerId.Value}' set to {money.Amount:F2} {money.Currency} successfully.";

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _globalErrorMessage = $"Failed to save override: {ex.Message}";
        }
    }

    private void PopulateForEdit(UserBudgetOverride ov)
    {
        _newCallerId = ov.CallerId.Value;
        _newAmount = ov.Amount.Amount;
        _newCurrency = ov.Amount.Currency;
    }

    private async Task DeleteOverrideAsync(string email)
    {
        if (!_isAdmin) return;
        try
        {
            var callerId = CallerId.From(email);
            await using var context = await DbFactory.CreateDbContextAsync();
            var repo = new UserBudgetOverrideRepository(context);

            await repo.DeleteAsync(callerId, _currentPeriod);
            _globalSuccessMessage = $"Budget override for user '{email}' cleared successfully.";
            _globalErrorMessage = null;

            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            _globalErrorMessage = $"Failed to delete override: {ex.Message}";
        }
    }
}
